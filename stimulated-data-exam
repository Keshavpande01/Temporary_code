# ============================================================
# Simulated Data - PCA + K-Means Clustering
# ============================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans
from sklearn.metrics import confusion_matrix, adjusted_rand_score

# ------------------------------------------------------------
# 1. Generate simulated data
# ------------------------------------------------------------

np.random.seed(1)

n = 40
p = 10

X1 = np.random.normal(loc=0, scale=1, size=(n, p))
X2 = np.random.normal(loc=3, scale=1, size=(n, p))
X3 = np.random.normal(loc=-3, scale=1, size=(n, p))

X = np.vstack([X1, X2, X3])

true_labels = np.array(
    [0] * n +
    [1] * n +
    [2] * n
)

print("Data shape:", X.shape)
print("True label counts:")
print(pd.Series(true_labels).value_counts())

# ------------------------------------------------------------
# 2. Standardize data
# ------------------------------------------------------------

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# ------------------------------------------------------------
# 3. PCA with 2 components
# ------------------------------------------------------------

pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

print("\nExplained variance ratio:")
print(pca.explained_variance_ratio_)

print("\nTotal variance explained:")
print(pca.explained_variance_ratio_.sum())

# ------------------------------------------------------------
# 4. PCA plot using true labels
# ------------------------------------------------------------

plt.figure(figsize=(7, 5))
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=true_labels)
plt.xlabel("PC1")
plt.ylabel("PC2")
plt.title("PCA Plot of Simulated Data")
plt.show()

# ------------------------------------------------------------
# 5. K-Means clustering
# ------------------------------------------------------------

kmeans = KMeans(
    n_clusters=3,
    random_state=1,
    n_init=10
)

cluster_labels = kmeans.fit_predict(X_scaled)

print("\nK-Means cluster counts:")
print(pd.Series(cluster_labels).value_counts())

# ------------------------------------------------------------
# 6. Compare clusters with true labels
# ------------------------------------------------------------

print("\nConfusion Matrix:")
print(confusion_matrix(true_labels, cluster_labels))

print("\nCrosstab:")
print(pd.crosstab(
    true_labels,
    cluster_labels,
    rownames=["True Class"],
    colnames=["K-Means Cluster"]
))

ari = adjusted_rand_score(true_labels, cluster_labels)
print("\nAdjusted Rand Index:", ari)

# ------------------------------------------------------------
# 7. K-Means clusters on PCA plot
# ------------------------------------------------------------

plt.figure(figsize=(7, 5))
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=cluster_labels)
plt.xlabel("PC1")
plt.ylabel("PC2")
plt.title("K-Means Clusters on PCA Plot")
plt.show()
